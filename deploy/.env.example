# 复制为 deploy/.env 并填写。三个值都不设好，compose 会拒绝启动（fail-loud）。

# PostgreSQL 密码：换成长随机串（openssl rand -hex 24）
POSTGRES_PASSWORD=change-me-long-random

# 观测者鉴权 token：换成长随机串（openssl rand -hex 24）。首次访问 https://DOMAIN/?token=它，之后 cookie 接管
POTHOS_TOKEN=change-me-long-random

# 公网域名（DNS A 记录指向服务器 IP）；内网部署可不管 caddy
DOMAIN=pothos.example.com
ACME_EMAIL=you@example.com

# ── 信件投递面（可选）：八项凭据齐备才启用，缺任一项 = 信件通道诚实缺席 ──
# Gmail 示例（应用专用密码：Google 账号 → 安全性 → 两步验证 → 应用专用密码）：
#   POTHOS_SMTP_HOST=smtp.gmail.com
#   POTHOS_SMTP_PORT=465
#   POTHOS_SMTP_USER=you@gmail.com
#   POTHOS_SMTP_PASS=<16位应用专用密码>
#   POTHOS_SMTP_FROM=you@gmail.com
#   POTHOS_IMAP_HOST=imap.gmail.com
#   POTHOS_IMAP_PORT=993
#   POTHOS_IMAP_USER=you@gmail.com
#   POTHOS_IMAP_PASS=<同一把应用专用密码>
#   POTHOS_MAIL_TO=<她的收件地址>
#   POTHOS_MAIL_PLUS_TAG=pothos        # plus 门牌后缀（默认 pothos）
# 锁纪律（她定案）：MAIL_TO 管发（只能发给她）；收信 SEARCH FROM "她" TO "you+pothos@…" 双条件
# 字面化——白名单外的信字面不可见；Message-ID 管线。凭据不入仓库，只进 deploy/.env（已 gitignore）。
